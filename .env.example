# --- Admin dashboard (required for /admin) ---
# Set automatically when a Neon database is connected in Vercel → Storage.
DATABASE_URL=
# Set automatically when a Vercel Blob store is connected (photo uploads).
BLOB_READ_WRITE_TOKEN=
# A long secret phrase used once, to create the first admin at /admin/setup.
ADMIN_SETUP_CODE=

# --- Optional: email a copy of each Booking / Join request (https://resend.com) ---
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL="Melodies of Praise <website@yourdomain.com>"

# --- Optional: AI help desk ("Ask MOP" chat), https://console.anthropic.com ---
# The chat button only appears when this is set.
ANTHROPIC_API_KEY=
# HELPDESK_MODEL=

# --- Local development only ---
# LOCAL_DB=pglite uses an embedded Postgres in ./.pglite instead of Neon.
# LOCAL_DB=pglite
